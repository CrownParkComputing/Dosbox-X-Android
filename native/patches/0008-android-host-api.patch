diff --git a/src/gui/dosboxx_host.cpp b/src/gui/dosboxx_host.cpp
new file mode 100644
index 00000000..82a8ec5d
--- /dev/null
+++ b/src/gui/dosboxx_host.cpp
@@ -0,0 +1,76 @@
+/* DOSBox-X host bridge implementation. See include/dosboxx_host.h.
+ *
+ * Thin by design: each entry forwards to the core function that real SDL
+ * input would have reached, so a host-driven key or stick is
+ * indistinguishable from a physical one. Anything thicker than a forward
+ * belongs on the host side of the door.
+ */
+#include "dosboxx_host.h"
+
+#include "dosbox.h"
+#include "keyboard.h"
+#include "mouse.h"
+#include "joystick.h"
+
+void DoKillSwitch(void);
+void PauseDOSBox(bool pressed);
+
+void dosboxx_host_quit(void)
+{
+	DoKillSwitch();
+}
+
+void dosboxx_host_set_pause(bool paused)
+{
+	/* PauseDOSBox toggles on press; it blocks inside its own event loop
+	 * until unpaused, so only ever call it for the transition wanted. */
+	static bool is_paused = false;
+	if (paused == is_paused)
+		return;
+	is_paused = paused;
+	if (paused)
+		PauseDOSBox(true);
+	/* Unpause is delivered by PauseDOSBox's own loop reading a key; the
+	 * host resumes by sending any key through dosboxx_host_key. */
+}
+
+void dosboxx_host_key(int kbd_key, bool pressed)
+{
+	if (kbd_key <= KBD_NONE || kbd_key >= KBD_LAST)
+		return;
+	KEYBOARD_AddKey((KBD_KEYS)kbd_key, pressed);
+}
+
+void dosboxx_host_mouse_move(float dx, float dy)
+{
+	if (dx == 0.0f && dy == 0.0f)
+		return;
+	Mouse_CursorMoved(dx, dy, 0.0f, 0.0f, true);
+}
+
+void dosboxx_host_mouse_button(int button, bool pressed)
+{
+	if (button < 0 || button > 2)
+		return;
+	if (pressed)
+		Mouse_ButtonPressed((uint8_t)button);
+	else
+		Mouse_ButtonReleased((uint8_t)button);
+}
+
+void dosboxx_host_joy_axis(int which, float x, float y)
+{
+	if (which < 0 || which > 1)
+		return;
+	JOYSTICK_Enable((Bitu)which, true);
+	JOYSTICK_Move_X((Bitu)which, x);
+	JOYSTICK_Move_Y((Bitu)which, y);
+}
+
+void dosboxx_host_joy_button(int which, int button, bool pressed)
+{
+	if (which < 0 || which > 1 || button < 0 || button > 1)
+		return;
+	JOYSTICK_Enable((Bitu)which, true);
+	JOYSTICK_Button((Bitu)which, (Bitu)button, pressed);
+}
