diff --git a/include/dosboxx_host.h b/include/dosboxx_host.h
new file mode 100644
index 00000000..f3359d13
--- /dev/null
+++ b/include/dosboxx_host.h
@@ -0,0 +1,55 @@
+/* DOSBox-X host bridge — the one door between the core and any front end.
+ *
+ * Plain C, dlsym-able: the Flutter launcher (and any future host) drives
+ * emulation through these and nothing else. The core draws the game and
+ * runs the machine; every control surface — keyboards, pads, menus,
+ * settings — belongs to the host. Mirrors uae4arm_host.h in the sibling
+ * Amiga project, where this shape is proven on Android and iOS.
+ *
+ * Entry to emulation itself stays SDL_main (SDLActivity's contract);
+ * these are the controls around it.
+ */
+#ifndef DOSBOXX_HOST_H
+#define DOSBOXX_HOST_H
+
+#include <stdbool.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* ---- session ----------------------------------------------------------- */
+
+/* Ends emulation; the main loop unwinds and SDL_main returns. */
+void dosboxx_host_quit(void);
+
+/* Pauses or resumes the machine. */
+void dosboxx_host_set_pause(bool paused);
+
+/* ---- keyboard ---------------------------------------------------------- */
+
+/* [key] is a KBD_* value from include/keyboard.h — the core's own numbering,
+ * which is the only one that means the same thing on every host. Press on
+ * touch-down, release on touch-up: DOS programs read the BIOS/hardware
+ * state, and a held key must stay held. */
+void dosboxx_host_key(int kbd_key, bool pressed);
+
+/* ---- mouse ------------------------------------------------------------- */
+
+/* Relative deltas, trackpad-style: DOS moves its own pointer. */
+void dosboxx_host_mouse_move(float dx, float dy);
+
+/* button: 0 left, 1 right, 2 middle. */
+void dosboxx_host_mouse_button(int button, bool pressed);
+
+/* ---- joystick ---------------------------------------------------------- */
+
+/* which: 0 or 1. Axes are -1.0 .. +1.0. */
+void dosboxx_host_joy_axis(int which, float x, float y);
+void dosboxx_host_joy_button(int which, int button, bool pressed);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* DOSBOXX_HOST_H */
