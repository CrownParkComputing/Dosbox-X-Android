+#ifdef __ANDROID__
+    /* DOSBox-X narrates its whole startup to stdout, and on Android stdout
+     * goes nowhere - which turns any launch failure into a silent black
+     * screen. Point it somewhere a person can read. */
+    {
+        const char *extpath = SDL_AndroidGetExternalStoragePath();
+        if (extpath != NULL) {
+            std::string lp = std::string(extpath) + "/dosbox-stdout.log";
+            if (freopen(lp.c_str(), "w", stdout) != NULL)
+                setvbuf(stdout, NULL, _IONBF, 0);
+            if (freopen(lp.c_str(), "a", stderr) != NULL)
+                setvbuf(stderr, NULL, _IONBF, 0);
+        }
+    }
 #endif
     CommandLine com_line(argc,argv);
     Config myconf(&com_line);
