#!/bin/sh
SDLINC="/home/jon/dosbox-x-pic/vs/sdl2/include"
LIBDIR="/home/jon/StudioProjects/DosboxMultiplatform/native/dosbox_core/android/.tmp/lib-arm64-v8a"
