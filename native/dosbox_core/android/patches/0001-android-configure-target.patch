diff --git a/configure.ac b/configure.ac
index a0116df16..fb305e0c4 100644
--- a/configure.ac
+++ b/configure.ac
@@ -713,6 +713,17 @@ case "$host" in
        dnl FEATURE: Whether to support direct serial port pass-through
        AC_DEFINE(C_DIRECTSERIAL, 1, [ Define to 1 if you want serial pass-through support (Win32, Posix and OS/2).])
        ;;
+    *-*-android*)
+       dnl Android is Linux-kernel based, but bionic has no librt (shm_*/clock_*
+       dnl live in libc) and has no parallel/serial port pass-through. Keep the
+       dnl LINUX feature define so the POSIX code paths build, but drop the
+       dnl Linux-desktop-only bits. Added by the Android port (native/patches).
+       AC_DEFINE(LINUX, 1, [Compiling on GNU/Linux])
+       AC_DEFINE(ANDROID, 1, [Compiling on Android])
+       CXXFLAGS="$CXXFLAGS -D_XOPEN_SOURCE=700 -D_POSIX_C_SOURCE=200809L"
+       dnl FEATURE: Whether to support direct serial port pass-through
+       AC_DEFINE(C_DIRECTSERIAL, 1, [ Define to 1 if you want serial pass-through support (Win32, Posix and OS/2).])
+       ;;
     *-*-linux*)
        AC_DEFINE(LINUX, 1, [Compiling on GNU/Linux])
        CXXFLAGS="$CXXFLAGS -D_XOPEN_SOURCE=700 -D_POSIX_C_SOURCE=200809L"
