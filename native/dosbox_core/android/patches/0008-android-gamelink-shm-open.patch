diff --git a/src/gamelink/gamelink.cpp b/src/gamelink/gamelink.cpp
index 6e5c9f61..7faf625c 100644
--- a/src/gamelink/gamelink.cpp
+++ b/src/gamelink/gamelink.cpp
@@ -80,6 +80,10 @@ static HANDLE g_mmap_handle;
 static sem_t* g_mutex_handle;
 static int g_mmap_handle; // fd!
 
+#if defined(__ANDROID__)
+static sem_t g_android_mutex;
+#endif
+
 #endif // WIN32
 
 static bool g_trackonly_mode;
@@ -172,6 +176,19 @@ static int create_mutex( const char* p_name )
 
 #else // WIN32
 
+#if defined(__ANDROID__)
+	/* Android does not implement POSIX named semaphores. Game Link is consumed
+	   in-process by the Flutter bridge, so an unnamed process-local semaphore
+	   provides the locking it needs without sem_open(). */
+	(void)p_name;
+	if (sem_init(&g_android_mutex, 0, 1) == 0) {
+		g_mutex_handle = &g_android_mutex;
+		return 1;
+	}
+	LOG_MSG( "GAMELINK: Creating Android mutex failed. errno = %d", errno );
+	g_mutex_handle = nullptr;
+#else
+
 	// The mutex is already open?
 	g_mutex_handle = sem_open( p_name, 0, 0666, 0 );
 	if ( g_mutex_handle != SEM_FAILED )
@@ -196,6 +213,8 @@ static int create_mutex( const char* p_name )
 		return 1;
 	}
 
+#endif // !defined(__ANDROID__)
+
 #endif // WIN32
 
 	return 0;
@@ -221,6 +240,14 @@ static void destroy_mutex( const char* p_name )
 
 #else // WIN32
 
+#if defined(__ANDROID__)
+	(void)p_name;
+	if ( g_mutex_handle ) {
+		sem_destroy( g_mutex_handle );
+		g_mutex_handle = nullptr;
+	}
+#else
+
 	if ( g_mutex_handle )
 	{
 		sem_close( g_mutex_handle );
@@ -228,6 +255,8 @@ static void destroy_mutex( const char* p_name )
 		g_mutex_handle = NULL;
 	}
 
+#endif // !defined(__ANDROID__)
+
 #endif // WIN32
 }
 
@@ -267,6 +267,23 @@ static int create_shared_memory()
 
 #else // WIN32
 
+#if defined(__ANDROID__)
+	/* Android's bionic libc has no shm_open / shm_unlink. Use an anonymous
+	   mapping -- nothing can attach to a shm_open mapping on Android
+	   anyway, and memory.cpp's MemBase still points into this block, so
+	   the failure mode of "shm_open returns -1" here is exactly "Can't
+	   allocate main memory of 32768 KB". */
+	g_mmap_handle = -1;
+	g_p_shared_memory = reinterpret_cast< GameLink::sSharedMemoryMap_R4* >(
+		mmap(nullptr, memory_map_size, PROT_READ | PROT_WRITE,
+		     MAP_PRIVATE | MAP_ANONYMOUS, -1, 0)
+	);
+	if (g_p_shared_memory == MAP_FAILED) {
+		g_p_shared_memory = NULL;
+		return 0;
+	}
+	return 1;
+#else
 	g_mmap_handle = shm_open( GAMELINK_MMAP_NAME, O_CREAT
 #ifndef MACOSX
 								| O_TRUNC
@@ -287,7 +304,9 @@ static int create_shared_memory()
 			LOG_MSG( "GAMELINK: ftruncate failed with %d. errno = %d", r, errno );
 			close( g_mmap_handle );
 			g_mmap_handle = -1;
+#if !defined(__ANDROID__)
 			shm_unlink( GAMELINK_MMAP_NAME );
+#endif
 			g_p_shared_memory = NULL;
 			return 0;
 		}
@@ -311,6 +330,7 @@ static int create_shared_memory()
 		return 1;
 	}
 
+#endif // !defined(__ANDROID__)
 #endif // WIN32
 
 	// Failure
@@ -354,7 +374,9 @@ static void destroy_shared_memory()
 		g_mmap_handle = -1;
 	}
 
+#if !defined(__ANDROID__)
 	shm_unlink( GAMELINK_MMAP_NAME );
+#endif
 
 #endif // WIN32
 
