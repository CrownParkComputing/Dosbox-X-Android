diff --git a/src/gui/sdlmain.cpp b/src/gui/sdlmain.cpp
index 7ec7db905..3688131cc 100644
--- a/src/gui/sdlmain.cpp
+++ b/src/gui/sdlmain.cpp
@@ -1117,6 +1117,20 @@ bool IsDebuggerActive(void);
 
 extern std::string dosbox_title;
 
+#if defined(__ANDROID__)
+#include <jni.h>
+/* DOSBox-X's status line (incl. "FPS nn, nn%/RT" when showdetails=true) would go
+   in the window title; on Android there is no title bar, so cache it here for the
+   Java-side FPS overlay (com.dosboxx.app.DosStatus.getStatusLine, a native
+   method — must exist or the overlay throws UnsatisfiedLinkError). */
+char android_status_line[256] = {0};
+extern "C" JNIEXPORT jstring JNICALL
+Java_com_dosboxx_app_DosStatus_getStatusLine(JNIEnv *env, jclass clazz) {
+    (void)clazz;
+    return env->NewStringUTF(android_status_line);
+}
+#endif
+
 void GFX_SetTitle(int32_t cycles, int frameskip, Bits timing, bool paused) {
     (void)frameskip;//UNUSED
     (void)timing;//UNUSED
@@ -1181,6 +1195,11 @@ void GFX_SetTitle(int32_t cycles, int frameskip, Bits timing, bool paused) {
 #if C_DEBUG
     if (IsDebuggerActive()) strcat(title," DEBUGGER");
 #endif
+#if defined(__ANDROID__)
+    /* expose the finished status line to the Java FPS overlay */
+    strncpy(android_status_line, title, sizeof(android_status_line)-1);
+    android_status_line[sizeof(android_status_line)-1] = 0;
+#endif
 #if defined(C_SDL2)
     SDL_SetWindowTitle(sdl.window,title);
 #else
@@ -1786,6 +1805,19 @@ SDL_Window* GFX_GetSDLWindow(void) {
 SDL_Window* GFX_SetSDLWindowMode(uint16_t width, uint16_t height, SCREEN_TYPES screenType)
 {
     static SCREEN_TYPES lastType = SCREEN_SURFACE;
+#if defined(__ANDROID__)
+    /* The Android SDL window is always the full display; keep the window/renderer
+       (and thus the GL viewport) at display size. The small DOS framebuffer is
+       handled as a content-sized texture scaled on the GPU (see output_surface +
+       SDL_DBX_SetContentSize), not by shrinking the window. */
+    {
+        SDL_DisplayMode dm;
+        if (SDL_GetDesktopDisplayMode(0, &dm) == 0 && dm.w > 0 && dm.h > 0) {
+            width = (uint16_t)dm.w;
+            height = (uint16_t)dm.h;
+        }
+    }
+#endif
     if (sdl.renderer) {
         SDL_DestroyRenderer(sdl.renderer);
         sdl.renderer = nullptr;
@@ -8615,6 +8647,14 @@ int main(int argc, char* argv[]) SDL_MAIN_NOEXCEPT {
     int workdirsave = 0;
     std::string workdirsaveas = "";
 
+#if defined(__ANDROID__)
+    /* Android has no interactive folder picker (no zenity/kdialog; tinyfd would
+       shell out and hang at 100% CPU when isatty(0)==false and cwd=="/", both
+       true on Android). Never prompt. All prompt logic below is gated on
+       opt_promptfolder < 0, so forcing 0 here disables it entirely. */
+    control->opt_promptfolder = 0;
+#endif
+
 #if defined(MACOSX) || defined(LINUX) || (defined(WIN32) && !defined(HX_DOS))
     {
         if(control->opt_promptfolder < 0) {
@@ -9332,8 +9372,11 @@ int main(int argc, char* argv[]) SDL_MAIN_NOEXCEPT {
         else {
             const char* env_driver = getenv("SDL_VIDEODRIVER");
             if(!env_driver || !*env_driver) {
-#if defined(LINUX)
+#if defined(LINUX) && !defined(__ANDROID__)
                 putenv("SDL_VIDEODRIVER=x11"); // default to x11 (xwayland) on Linux
+#elif defined(__ANDROID__)
+                /* let SDL auto-pick its "android" video driver; forcing x11 here
+                   makes SDL_Init fail with "x11 not available" */
 #elif defined(WIN32)
                 /* hack: Encourage SDL to use windib if not otherwise specified */
 #if defined(C_SDL2)
@@ -9541,6 +9584,27 @@ int main(int argc, char* argv[]) SDL_MAIN_NOEXCEPT {
         }
 #endif
 
+#if defined(__ANDROID__)
+        /* Load the launcher-written config from app-external storage. The workdir
+           logic above calls control->ClearExtraData(), which wipes every section's
+           data (including [autoexec]); parse our conf here, right before
+           GUI_StartUp, so the launcher's "mount c ... / run game" autoexec
+           actually executes instead of dropping to a bare Z:\> prompt. */
+        {
+            const char *extpath = SDL_AndroidGetExternalStoragePath();
+            if (extpath != NULL) {
+                std::string androidconf = std::string(extpath) + "/dosbox-x.conf";
+                struct stat ast;
+                if (stat(androidconf.c_str(), &ast) == 0 && S_ISREG(ast.st_mode)) {
+                    LOG_MSG("ANDROID: loading launcher config %s", androidconf.c_str());
+                    control->ParseConfigFile(androidconf.c_str());
+                } else {
+                    LOG_MSG("ANDROID: no launcher config at %s", androidconf.c_str());
+                }
+            }
+        }
+#endif
+
         /* GUI init */
         GUI_StartUp();
 
