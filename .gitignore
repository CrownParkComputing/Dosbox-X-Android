# Flutter / Dart
flutter_app/build/
flutter_app/.dart_tool/
flutter_app/.flutter-plugins
flutter_app/.flutter-plugins-dependencies
flutter_app/ios/Flutter/Generated.xcconfig
flutter_app/ios/Flutter/flutter_export_environment.sh
flutter_app/ios/Pods/
flutter_app/linux/flutter/ephemeral/
flutter_app/android/.gradle/
flutter_app/android/local.properties
flutter_app/android/app/src/main/jniLibs/**/*.so
**/*.iml

# Native core: large cross-compiled artifacts, rebuilt per machine.
# See docs/NATIVE_BUILD.md.
native/dosbox_core/*/build/
native/dosbox_core/**/*.o
native/dosbox_core/**/*.a
native/dosbox_core/**/*.so

# DOS games and disc images are never committed.
*.iso
*.cue
*.bin
*.img
*.ima
*.vhd

.DS_Store

# Build output APKs are never committed.
dist/
*.apk
*.aab

# Build-time shim dir (regenerated per machine).
native/dosbox_core/**/.tmp/
