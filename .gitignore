# Flutter / Dart
flutter_app/build/
flutter_app/.dart_tool/
flutter_app/.flutter-plugins
flutter_app/.flutter-plugins-dependencies
flutter_app/ios/Flutter/Generated.xcconfig
flutter_app/ios/Flutter/flutter_export_environment.sh
flutter_app/ios/Pods/
flutter_app/linux/flutter/ephemeral/
flutter_app/android/.gradle/
flutter_app/android/local.properties
# The jniLibs .so files are TRACKED, deliberately.
#
# They used to be ignored as build output, which meant the only working copy
# of the emulator was on whichever machine last built it: CI checked out a
# tree with no core in it and produced an app that installs, starts, and
# cannot run a single game. Nothing in the release pipeline noticed, because
# a missing core is not a build error.
#
# They are affordable now because they are stripped -- llvm-strip
# --strip-unneeded takes the pair from 190M to 36M, keeping every dynamic
# symbol that matters: the 27 dosbox_core_* bridge entries, SDL_main, and
# SDL2's 52 JNI natives. See docs/NATIVE_BUILD.md.
**/*.iml

# Native core: large cross-compiled artifacts, rebuilt per machine.
# See docs/NATIVE_BUILD.md.
native/dosbox_core/*/build/
native/dosbox_core/**/*.o
native/dosbox_core/**/*.a
native/dosbox_core/**/*.so

# DOS games and disc images are never committed.
*.iso
*.cue
*.bin
*.img
*.ima
*.vhd

.DS_Store

# Build output APKs are never committed.
dist/
*.apk
*.aab

# Build-time shim dir (regenerated per machine).
native/dosbox_core/**/.tmp/

# Keystore files (release signing config). The upload keystore is registered
# with Play Console under the com.dosboxx.app listing; never commit it.
*.jks
*.keystore
