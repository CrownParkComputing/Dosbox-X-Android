<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- A DOS collection is folders of .exe/.com/.bat plus .iso/.img/.zip.
         None of those are media types, so READ_MEDIA_* does not cover them and
         all-files access is the only permission that allows reading a games
         folder the user chose. Requested at runtime via the
         com.crownpark.retrodosbox/storage_permissions channel, not granted here. -->
    <!--
      MANAGE_EXTERNAL_STORAGE ("All files access") is deliberately NOT
      requested. Play treats it as a sensitive permission: undeclared it
      blocks the release outright, declared it means a review aimed at file
      managers, backup and antivirus apps. This app replaces a published one,
      which is not a thing to gate on that review.

      dosbox-x mounts a directory, so games have to live somewhere the app can
      genuinely read - its own external folder, Android/data/<pkg>/files,
      which needs no permission and is reachable over USB. A collection
      elsewhere is brought in through the system folder picker. See
      MediaFolderAccess.kt.
    -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"/>
    <uses-permission android:name="android.permission.VIBRATE"/>

    <!-- org.libsdl.app.HIDDeviceManager registers Bluetooth scan receivers and
         needs these even to compile cleanly into the APK. Android only actually
         grants them if the user has Bluetooth; the runtime check in
         initialize() handles that, but the manifest is still required. -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30"/>
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30"/>
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>

    <!-- All optional: this runs on phones, tablets, handhelds with physical
         controls, and desktop-style devices. Marking any of these required
         would hide the app from devices that can run it perfectly well. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false"/>
    <uses-feature android:name="android.hardware.gamepad" android:required="false"/>
    <uses-feature android:name="android.hardware.type.pc" android:required="false"/>

    <application
        android:label="Retro-Dosbox"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- The emulator, in a process of its own.
             Ending a session ends this process, which is what makes the core
             one-shot problem go away: Android reclaims whatever the engine
             leaked and the next game gets a genuinely fresh one, while the
             launcher's process is never touched. Same arrangement Retro-Amiga
             uses for its core in :sdl.
             Landscape and keep-screen-on because it is a game, not a form. -->
        <activity
            android:name=".DosboxEmulatorActivity"
            android:exported="false"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|navigation"
            android:launchMode="singleTask"
            android:process=":dosbox"
            android:screenOrientation="sensorLandscape"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen" />
        <!-- The one-shot core's way out.
             DOSBox-X's upstream globals have no complete teardown path, so a
             second start in the same process is unsafe - and the Quit that
             stop() relies on is delivered through the frame-publish hook,
             which a core that has stopped rendering never reaches. Rather
             than pretend, closing a game replaces the process: this activity
             runs in :restart, outlives the main process being killed, and
             brings MainActivity back into a fresh one. -->
        <activity
            android:name=".AppRestartActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:process=":restart"
            android:taskAffinity="com.crownpark.retrodosbox.restart"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>