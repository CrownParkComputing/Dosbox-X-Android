<?xml version="1.0" encoding="utf-8"?>
<!-- The background layer is the ARTWORK, not a flat colour resource.
     A launcher on Android 8+ masks these two layers to its own shape, and
     whatever the background does not cover comes back as the launcher's own
     plate - the white ring around a shrunken glyph that a legacy-only icon
     gets. The gradient bleeds to all four edges, so the icon fills the square
     whatever shape is cut from it. Only the middle 66% survives every mask,
     which is why the wordmark and the prompt sit in the foreground layer. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
